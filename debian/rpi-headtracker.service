# The head tracker: camera, face tracking, USB joystick and web page (port 18080).
# Runs as the system user "headtracker" with its config in /var/lib/rpi-headtracker.
[Unit]
Description=RPi head tracker (USB joystick, web page on port 18080)
Documentation=https://github.com/torstenknoefel/RPiUSBHeadTracker
Requires=rpi-headtracker-gadget.service
After=rpi-headtracker-gadget.service network-online.target
Wants=network-online.target
# The service of a development setup (install_service.sh) uses the same camera
# and joystick: starting this one stops that one
Conflicts=headtracker.service
# At most 5 crashes within 2 minutes, then systemd gives up
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=headtracker
Group=headtracker
SupplementaryGroups=video
StateDirectory=rpi-headtracker
WorkingDirectory=/var/lib/rpi-headtracker
# The first start gets the default settings; the web page changes them
ExecStartPre=/bin/sh -c 'test -e /var/lib/rpi-headtracker/config.json || cp /usr/share/rpi-headtracker/default.json /var/lib/rpi-headtracker/config.json'
ExecStart=/usr/bin/RPiUSBHeadTracker -c /var/lib/rpi-headtracker/config.json -d /usr/share/rpi-headtracker
# Only after a crash: systemctl stop ends the program normally
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
